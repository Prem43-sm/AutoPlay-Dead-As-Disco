!data/dataset/labels/val/.gitkeep
data/dataset/labels/test/*
!data/dataset/labels/test/.gitkeep
data/dataset/metadata/*
!data/dataset/metadata/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/sessions/*
!data/sessions/.gitkeep
